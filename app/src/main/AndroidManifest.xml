<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GPS speed and course-over-ground. This is the core of the app. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Declared alongside FINE because Android 12+ lets the user grant only
         approximate location; we still function (degraded) and it widens
         device/OEM compatibility. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Used ONLY to fetch update.json and download an update APK on request. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets us check connectivity before an update attempt so we fail quietly
         offline instead of hanging. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Floating speedometer bubble over other apps. User-granted at runtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keeps the bubble + its GPS reads alive while you are in another app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) requires a typed foreground service; the bubble
         reads location, so it is a location-type FGS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Launch the system installer for a user-approved OTA update APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Show the foreground-service notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GPS strongly recommended but not required to install (so the app can be
         installed on GPS-less tablets); handled gracefully at runtime. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrueSpeed"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
